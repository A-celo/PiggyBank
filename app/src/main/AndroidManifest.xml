<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.piggybank">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PiggyBank">
        <activity
            android:name="ui.home.EditGoalDialog"
            android:exported="false" />
        <activity
            android:name="ui.home.CreateGoalDialog"
            android:exported="false" />
        <activity
            android:name=".ui.auth.SignInActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity> <!-- REGISTER -->
        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false" /> <!-- FORGOT PASSWORD -->
        <activity
            android:name=".ui.auth.ForgotPasswordActivity"
            android:exported="false" /> <!-- HOME -->
        <activity
            android:name=".ui.home.HomeActivity"
            android:exported="false" /> <!-- ADD EXPENSE -->
        <activity
            android:name=".ui.home.AddExpenseActivity"
            android:exported="false" /> <!-- INSIGHTS -->
        <activity
            android:name=".ui.home.InsightsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.home.ProfileActivity"
            android:exported="false" />
        <activity
            android:name=".ui.home.GoalsActivity"
            android:exported="false" />
    </application>

</manifest>