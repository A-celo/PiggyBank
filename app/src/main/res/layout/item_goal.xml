<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp"
    android:background="@drawable/rectangle_2">

    <!-- Nombre del Goal -->
    <TextView
        android:id="@+id/tvGoalName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Trip to Paris"
        android:textSize="20sp"
        android:textColor="#4C4C4C"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnDeleteGoal"
        android:ellipsize="end"
        android:maxLines="1"/>

    <!-- Cantidad / Meta -->
    <TextView
        android:id="@+id/tvGoalProgress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="$1200 / $5000"
        android:textSize="15sp"
        android:textColor="#616161"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvGoalName"
        app:layout_constraintEnd_toStartOf="@+id/btnDeleteGoal"
        android:ellipsize="end"
        android:maxLines="1"/>

    <!-- Barra de progreso -->
    <ProgressBar
        android:id="@+id/progressBarGoal"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="0dp"
        android:layout_height="16dp"
        android:progress="24"
        android:max="100"
        android:progressTint="#C7B8EA"
        android:backgroundTint="#E0E0E0"
        app:layout_constraintTop_toBottomOf="@id/tvGoalProgress"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnDeleteGoal"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <!-- Botón Borrar Goal -->
    <ImageView
        android:id="@+id/btnDeleteGoal"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="Delete Goal"
        android:src="@android:drawable/ic_menu_delete"
        app:tint="#FF0000"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>

