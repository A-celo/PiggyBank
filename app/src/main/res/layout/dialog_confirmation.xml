<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialogConfirmation"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:clipToOutline="true"
    android:background="#C7B8EA"
    android:padding="16dp"
    android:gravity="center">

    <!-- Icono check -->
    <ImageView
        android:id="@+id/checkIcon"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="40dp"
        android:src="@drawable/check_circle"/>

    <!-- Mensaje principal -->
    <TextView
        android:id="@+id/tvYourAccount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/checkIcon"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="Your account was created successfully!"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        android:letterSpacing="0.03"
        android:lineSpacingExtra="-6sp"/>

    <!-- Mensaje secundario -->
    <TextView
        android:id="@+id/tvCheckEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvYourAccount"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="Check your e-mail for the confirmation mail to start saving!"
        android:textColor="#F3F3F3"
        android:textSize="20sp"
        android:letterSpacing="0.05"
        android:lineSpacingExtra="-4sp"/>

    <!-- Botón Ok -->
    <Button
        android:id="@+id/btnOk"
        android:layout_width="120dp"
        android:layout_height="50dp"
        android:layout_below="@id/tvCheckEmail"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:backgroundTint="#FFFFFF"
        android:text="Ok"
        android:textColor="#C7B8EA"
        android:textSize="18sp"/>
</RelativeLayout>

