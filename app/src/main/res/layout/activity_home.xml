<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA">

    <!-- Header morado -->
    <View
        android:id="@+id/headerBackground"
        android:layout_width="0dp"
        android:layout_height="115dp"
        android:background="#C7B8EA"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Logo -->
    <ImageView
        android:id="@+id/logoPig"
        android:layout_width="75dp"
        android:layout_height="106dp"
        android:layout_marginStart="22dp"
        android:layout_marginTop="9dp"
        android:src="@drawable/logopiggyhome"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- Nombre de la app -->
    <TextView
        android:id="@+id/tvAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Piggy Bank"
        android:textSize="40sp"
        android:textColor="#F5F5F5"
        android:textStyle="bold"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/headerBackground"
        app:layout_constraintBottom_toBottomOf="@id/headerBackground"/>

    <!-- Bienvenida al usuario -->
    <TextView
        android:id="@+id/tvWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hi Maria!"
        android:textSize="36sp"
        android:textColor="#3A3A3A"
        android:textStyle="bold"
        android:layout_marginStart="23dp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/headerBackground"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Gasto semanal -->
    <TextView
        android:id="@+id/tvWeeklySpend"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="You've spent $120 this week."
        android:textSize="24sp"
        android:textColor="#3A3A3A"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"
        android:layout_marginTop="14dp"
        app:layout_constraintTop_toBottomOf="@id/tvWelcome"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Dinero restante -->
    <TextView
        android:id="@+id/tvMoneyLeft"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="$80 left"
        android:textSize="24sp"
        android:textColor="#525252"
        android:layout_marginStart="22dp"
        android:layout_marginTop="35dp"
        app:layout_constraintTop_toBottomOf="@id/tvWeeklySpend"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Barra de progreso del budget -->
    <ProgressBar
        android:id="@+id/progressBudget"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="20dp"
        android:layout_marginStart="31dp"
        android:layout_marginEnd="31dp"
        android:layout_marginTop="11dp"
        android:progress="60"
        android:progressTint="#76BE34"
        android:progressBackgroundTint="#CAE7CF"
        app:layout_constraintTop_toBottomOf="@id/tvMoneyLeft"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Goal -->
    <TextView
        android:id="@+id/tvGoal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="$ 100 / 500 goal"
        android:textSize="24sp"
        android:textColor="#525252"
        android:layout_marginStart="20dp"
        android:layout_marginTop="37dp"
        app:layout_constraintTop_toBottomOf="@id/progressBudget"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Barra de progreso del goal -->
    <ProgressBar
        android:id="@+id/progressGoal"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="20dp"
        android:layout_marginStart="31dp"
        android:layout_marginEnd="31dp"
        android:layout_marginTop="13dp"
        android:progress="20"
        android:progressTint="#E5A000"
        android:progressBackgroundTint="#FDDCA7"
        app:layout_constraintTop_toBottomOf="@id/tvGoal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Botón Add Expense -->
    <Button
        android:id="@+id/btnAddExpense"
        android:layout_width="313dp"
        android:layout_height="63dp"
        android:text="Add expense"
        android:textColor="#F5FAFAFA"
        android:textSize="32sp"
        android:textAllCaps="false"
        android:backgroundTint="#C7B8EA"
        android:layout_marginTop="53dp"
        app:layout_constraintTop_toBottomOf="@id/progressGoal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Gráfica circular (placeholder) -->
    <View
        android:id="@+id/chartPlaceholder"
        android:layout_width="151dp"
        android:layout_height="148dp"
        android:background="#E8E0F5"
        android:layout_marginTop="53dp"
        app:layout_constraintTop_toBottomOf="@id/btnAddExpense"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Etiquetas de categorías -->
    <LinearLayout
        android:id="@+id/categoryLabels"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/chartPlaceholder"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomMenu">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Food"
            android:textSize="24sp"
            android:textColor="#525252"
            android:gravity="start"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Transport"
            android:textSize="24sp"
            android:textColor="#525252"
            android:gravity="end"/>
    </LinearLayout>

    <!-- Bottom Navigation -->
    <LinearLayout
        android:id="@+id/bottomMenu"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:gravity="center"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

    <!-- Home -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_home"
                app:tint="#6750A4" />
            <TextView
                android:id="@+id/menuHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textSize="14sp"
                android:textColor="#6750A4"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Add -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_plus"
                app:tint="#C7B8EA" />
            <TextView
                android:id="@+id/menuAdd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add"
                android:textSize="14sp"
                android:textColor="#C7B8EA"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Insights -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_insights"
                app:tint="#C7B8EA" />
            <TextView
                android:id="@+id/menuInsights"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Insights"
                android:textSize="14sp"
                android:textColor="#C7B8EA"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Goals -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_goals"
                app:tint="#C7B8EA" />
            <TextView
                android:id="@+id/menuGoals"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Goals"
                android:textSize="14sp"
                android:textColor="#C7B8EA"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Profile -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_profile"
                app:tint="#C7B8EA" />
            <TextView
                android:id="@+id/menuProfile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile"
                android:textSize="14sp"
                android:textColor="#C7B8EA"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>