<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.home.InsightsActivity">

    <!-- ================= HEADER ================= -->

    <View
        android:id="@+id/headerBackground"
        android:layout_width="0dp"
        android:layout_height="115dp"
        android:background="#C7B8EA"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ImageView
        android:id="@+id/logoPig"
        android:layout_width="75dp"
        android:layout_height="106dp"
        android:layout_marginStart="22dp"
        android:layout_marginTop="9dp"
        android:src="@drawable/logopiggyhome"
        android:scaleType="fitCenter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/tvAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Piggy Bank"
        android:textSize="40sp"
        android:textColor="#F5F5F5"
        android:textStyle="bold"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/headerBackground"
        app:layout_constraintBottom_toBottomOf="@id/headerBackground"/>

    <!-- ================= BACK + TITLE ================= -->

    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="24dp"
        android:src="@drawable/arrow_back_black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerBackground"/>


    <TextView
        android:id="@+id/tvInsights"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Insights"
        android:textColor="#4C4C4C"
        android:textSize="32sp"
        android:textStyle="bold"
        tools:layout_editor_absoluteX="67dp"
        tools:layout_editor_absoluteY="127dp" />

    <!-- ================= TOGGLES ================= -->

    <LinearLayout
        android:id="@+id/toggleGroup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:layout_editor_absoluteY="190dp">

        <TextView
            android:id="@+id/tvWeekly"
            style="@style/InsightToggle"
            android:text="Weekly" />

        <TextView
            android:id="@+id/tvMonthly"
            style="@style/InsightToggle"
            android:layout_marginHorizontal="16dp"
            android:text="Monthly" />

        <TextView
            android:id="@+id/tvYearly"
            style="@style/InsightToggle"
            android:text="Yearly" />
    </LinearLayout>

    <!-- ================= CHART PLACEHOLDER ================= -->

    <View
        android:id="@+id/chartPlaceholder"
        android:layout_width="0dp"
        android:layout_height="220dp"
        android:layout_margin="24dp"
        android:background="#EFEFEF"
        app:layout_constraintTop_toBottomOf="@id/toggleGroup"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ================= TOP CATEGORY ================= -->

    <View
        android:id="@+id/topCategoryCard"
        android:layout_width="0dp"
        android:layout_height="65dp"
        android:layout_margin="24dp"
        android:background="@drawable/rectangle_2"
        app:layout_constraintTop_toBottomOf="@id/chartPlaceholder"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Bottom Navigation -->
    <LinearLayout
        android:id="@+id/bottomMenu"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:gravity="center"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Home -->
        <LinearLayout
            android:id="@+id/menuHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:id="@+id/iconHome"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_home"
                app:tint="#6750A4"/>
            <TextView
                android:id="@+id/textHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textSize="14sp"
                android:textColor="#6750A4"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Add -->
        <LinearLayout
            android:id="@+id/menuAdd"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:id="@+id/iconAdd"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_plus"
                app:tint="#C7B8EA"/>
            <TextView
                android:id="@+id/textAdd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add"
                android:textSize="14sp"
                android:textColor="#C7B8EA"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Insights -->
        <LinearLayout
            android:id="@+id/menuInsights"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:id="@+id/iconInsights"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_insights"
                app:tint="#C7B8EA"/>
            <TextView
                android:id="@+id/textInsights"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Insights"
                android:textSize="14sp"
                android:textColor="#C7B8EA"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Goals -->
        <LinearLayout
            android:id="@+id/menuGoals"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:id="@+id/iconGoals"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_goals"
                app:tint="#C7B8EA"/>
            <TextView
                android:id="@+id/textGoals"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Goals"
                android:textSize="14sp"
                android:textColor="#C7B8EA"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Profile -->
        <LinearLayout
            android:id="@+id/menuProfile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:id="@+id/iconProfile"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_profile"
                app:tint="#C7B8EA"/>
            <TextView
                android:id="@+id/textProfile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile"
                android:textSize="14sp"
                android:textColor="#C7B8EA"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
