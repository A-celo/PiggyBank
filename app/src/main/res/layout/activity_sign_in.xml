<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <!-- Logo -->
    <ImageView
        android:id="@+id/logoPiggyBank"
        android:layout_width="304dp"
        android:layout_height="429dp"
        android:src="@drawable/piggylogo"
        android:contentDescription="Logo Piggy Bank"
        android:scaleType="centerCrop"
        android:background="#D3D3D3"
        android:layout_marginTop="48dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Title Piggy Bank -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Piggy Bank"
        android:textColor="#000000"
        android:textSize="48sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/logoPiggyBank"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- "Sign In" -->
    <TextView
        android:id="@+id/tvSignIn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sign In"
        android:textColor="#525252"
        android:textSize="24sp"
        android:textStyle="bold"
        android:letterSpacing="0.02"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Email EditText -->
    <EditText
        android:id="@+id/etEmail"
        android:layout_width="319dp"
        android:layout_height="34dp"
        android:hint="e-mail"
        android:textColor="#767676"
        android:textColorHint="#767676"
        android:gravity="start|center_vertical"
        android:paddingStart="12dp"
        android:inputType="textEmailAddress"
        android:background="#F5F5F5"
        android:layout_marginTop="12dp"
        android:fontFamily="sans-serif"
        app:layout_constraintTop_toBottomOf="@id/tvSignIn"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Password EditText -->
    <EditText
        android:id="@+id/etPassword"
        android:layout_width="319dp"
        android:layout_height="34dp"
        android:hint="password"
        android:textColor="#767676"
        android:textColorHint="#767676"
        android:gravity="start|center_vertical"
        android:paddingStart="12dp"
        android:inputType="textPassword"
        android:background="#F5F5F5"
        android:layout_marginTop="12dp"
        android:fontFamily="sans-serif"
        app:layout_constraintTop_toBottomOf="@id/etEmail"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Forgot Password (alineado a la derecha) -->
    <TextView
        android:id="@+id/tvForgotPassword"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="I forgot my password"
        android:textColor="#9B0D0D"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/etPassword"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Log In Button -->
    <Button
        android:id="@+id/btnSignIn"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Log In"
        android:textColor="#F5F5F5"
        android:textSize="32sp"
        android:textStyle="bold"
        android:letterSpacing="0.02"
        android:backgroundTint="#C7B8EA"
        android:layout_marginTop="24dp"
        android:clipToOutline="true"
        app:layout_constraintTop_toBottomOf="@id/tvForgotPassword"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Bottom Text: "Don't have an account? Register here!" -->
    <LinearLayout
        android:id="@+id/bottomTextLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/btnSignIn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Don't have an account? "
            android:textColor="#393636"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvRegister"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Register here!"
            android:textColor="#C7B8EA"
            android:textSize="16sp"
            android:textStyle="bold"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>


